{% raw %}[project]
name = "{% endraw %}{{ repo_name | replace('_', '-') }}{% raw %}"
version = "0.1.0"
description = "{% endraw %}{{ description }}{% raw %}"
readme = "README.md"
requires-python = ">={% endraw %}{{ python_version }}{% raw %}"
dependencies = [
    # Specific to this template


    # Managed by upstream template
    "pytest{% endraw %}{{ pytest_version }}{% raw %}",
    "pytest-cov{% endraw %}{{ pytest_cov_version }}{% raw %}",
    "pytest-randomly{% endraw %}{{ pytest_randomly_version }}{% raw %}",
    "faker{% endraw %}{{ python_faker_version }}{% raw %}",
    "pyrefly{% endraw %}{{ pyrefly_version }}{% raw %}",
    "copier{% endraw %}{{ copier_version }}{% raw %}",
    "copier-template-extensions{% endraw %}{{ copier_template_extensions_version }}{% raw %}"
]

[[tool.uv.index]]
name = "pypi"
url = "https://pypi.org/simple/"
exclude-newer = "1 day"

[tool.tach]
source_roots = ["src", "."]
exclude = [".venv", "**/__pycache__", "**/*.egg-info", "template", "mutants", "copier_template_resources"]

# Never import from a conftest.py (https://docs.pytest.org/en/stable/how-to/writing_plugins.html#conftest-py-local-per-directory-plugins);
# put shared helpers in a regular module instead. Declaring `tests` as a module is what makes tach check the tests'
# imports at all; a file outside every module is never checked.
[[tool.tach.modules]]
path = "tests"
cannot_depend_on = ["tests.**.conftest"]

# Makes each conftest.py its own module, so the rule above has something to match. tach puts a file only in its most
# specific module, so conftests are not part of `tests` and need the rule repeated to block conftest-to-conftest imports.
# `visibility = []` also rejects any module that lists a conftest in its `depends_on`. It can't stop a module that omits
# `depends_on`, so any other module declared under `tests` needs the same `cannot_depend_on` line.
[[tool.tach.modules]]
path = "tests.**.conftest"
cannot_depend_on = ["tests.**.conftest"]
visibility = []

[tool.tach.external]
# Tooling run from the command line or as pytest plugins, or imported only by the tests (which check-external skips)
exclude = ["copier", "faker", "pyrefly", "pytest", "pytest_cov", "pytest_randomly"]{% endraw %}
