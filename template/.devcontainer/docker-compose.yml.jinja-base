{% raw %}services:
  devcontainer:
    # added the platform flag to override any local settings since this image is only compatible with linux/amd64.
    platform: linux/amd64
    build:
      context: .
      args:
        REPO_NAME: {% endraw %}{{ repo_name }}{% raw %}
    # You can run `devcontainer-info content-url` in codespaces to see what image base is
    volumes:
      - ..:/workspaces/{% endraw %}{{ repo_name }}{% raw %}:cached
      # Break out the venv folder as a separate docker volume for better performance on Windows hosts
      - python_venv:/workspaces/{% endraw %}{{ repo_name }}{% raw %}/.venv
    command: sleep infinity
    ports:
      - "{% endraw %}{{ ssh_port_number }}{% raw %}:2222"
    environment:
      - AWS_PROFILE=localstack
      - AWS_DEFAULT_REGION={% endraw %}{{ aws_region_for_stack if (aws_region_for_stack is defined and aws_region_for_stack != "") else "us-east-1" }}{% raw %}{% endraw %}{% if install_claude_cli %}{% raw %}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
      - BEADS_DIR=/workspaces/{% endraw %}{{ repo_name }}{% raw %}/.claude/.beads
      - BEADS_DOLT_SERVER_MODE=1 # bd >=1.0 defaults to embedded dolt, and bd init hard-fails when the server host/port are set without this
      - BEADS_DOLT_SERVER_HOST=beads-dolt # this is on the docker compose network. We don't want to publish the server port because then the local machine would have a bunch of conflicts with multiple devcontainers running
      - BEADS_DOLT_SERVER_PORT=3306
      - BEADS_DOLT_SERVER_DATABASE=beads_work
      - BEADS_DOLT_AUTO_START=0 # the beads-dolt service owns the server lifecycle, so bd must never spawn its own
      - BD_DISABLE_METRICS=1 # bd >=1.0 sends anonymous usage metrics by default


  beads-dolt:
    image: dolthub/dolt-sql-server:2.1.0 # the version beads 1.2.2 pins for its own integration tests (internal/testutil/testdoltcommon.go)
    volumes:
      - beads_dolt_data:/var/lib/dolt
    environment:
      - DOLT_ROOT_HOST=%
      - DOLT_DATABASE=beads_work
      - DOLT_DISABLE_EVENT_FLUSH=1 # dolt contacts doltremoteapi.dolthub.com with usage metrics by default, even with no remotes configured (see beads SECURITY.md){% endraw %}{% endif %}{% raw %}


volumes:{% endraw %}{% if install_claude_cli %}{% raw %}
  beads_dolt_data: {}{% endraw %}{% endif %}{% raw %}
  python_venv: {}{% endraw %}
