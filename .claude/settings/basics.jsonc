{
  // Basic configuration for Claude Code
  // General settings, environment variables, and UI customization
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": false,
  // A template repository holds, under template/, the copies of AGENTS.md and .claude/rules that generated repositories receive. Claude Code loads such a nested copy as live instructions whenever a file beside it is read, on top of the repository's own, and .claudeignore does not stop that.
  "claudeMdExcludes": [
    // Deliberately not anchored on /workspaces like the tmp/ patterns below: a template repository is then covered wherever it is checked out (a scratch checkout, a clone outside a devcontainer). The price is that a repository checked out beneath a directory itself named template loses its own instructions, and nothing in this template chain checks one out there.
    "**/template/AGENTS.md",
    "**/template/**/AGENTS.md",
    "**/template/.claude/rules/**",
    "**/template/**/.claude/rules/**",
    // Anything under a repository's own tmp/ is a copy or scratch data (a review-open-pr worktree, guidance arms under test), and its instruction files load the same way. The session's own rules still match the files inside it. Anchored on /workspaces, where these devcontainers mount a repository, so that a repository checked out under the system /tmp never excludes its own files.
    "/workspaces/*/tmp/**/AGENTS.md",
    "/workspaces/*/tmp/**/.claude/rules/**"
  ],
  "env": {
    // An agent cannot answer a credential prompt, so its git must fail when no helper has credentials rather than ask. Left to ask, git waits on VS Code's askpass, which never answers once the session's VSCODE_GIT_IPC_HANDLE names an extension host whose window has gone, and then on the terminal. Credentials come from git's credential helpers instead; .devcontainer/post-start-command.sh adds the one that covers pushes to other repositories.
    "GIT_ASKPASS": "", // set but empty, which git reads as no askpass program
    "GIT_TERMINAL_PROMPT": "0"
  }
}
