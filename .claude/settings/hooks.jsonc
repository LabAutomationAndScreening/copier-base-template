{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          // `git rev-parse --show-toplevel` is used for these to find the project root, since these commands are always guaranteed to be running within the repo's working tree
          {
            "type": "command",
            "command": "sh -c 'SESSION=$(jq -r \".session_id\" 2>/dev/null); DIR=\"/tmp/claude-$(id -u)\"; mkdir -p \"$DIR\"; printf \"%s\" \"$(git rev-parse --show-toplevel)\" > \"$DIR/.claude_project_root_${SESSION}\"'",
            "timeout": 5,
            "statusMessage": "Caching project root...",
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode...",
          },
        ],
      },
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'INPUT=$(cat); SESSION=$(printf \"%s\" \"$INPUT\" | jq -r \".session_id\" 2>/dev/null); ROOT=$(cat \"/tmp/claude-$(id -u)/.claude_project_root_${SESSION}\"); printf \"%s\" \"$INPUT\" | PROJECT_ROOT_DIR=\"$ROOT\" node \"$ROOT/.claude/hooks/caveman-mode-tracker.js\"'",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode...",
          },
        ],
      },
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'INPUT=$(cat); SESSION=$(printf \"%s\" \"$INPUT\" | jq -r \".session_id\" 2>/dev/null); ROOT=$(cat \"/tmp/claude-$(id -u)/.claude_project_root_${SESSION}\"); printf \"%s\" \"$INPUT\" | node \"$ROOT/.claude/hooks/bash-chain-guard.js\"'",
            "timeout": 5,
            "statusMessage": "Checking for command chaining...",
          },
          // Reports `git push`es that add un-audited source comments. Starts in `warn`: it never blocks,
          // it just points at /comment-audit. Switch COMMENT_GATE_MODE to `block` once the reports have
          // proven trustworthy on this repo, or to `off` to silence it.
          {
            "type": "command",
            "command": "sh -c 'GATE=\"$CLAUDE_PROJECT_DIR/.claude/skills/comment-audit/comment-gate.py\"; if [ -f \"$GATE\" ]; then COMMENT_GATE_MODE=warn python3 \"$GATE\"; fi'",
            "timeout": 30,
            "statusMessage": "Checking for un-audited comments...",
          },
        ],
      },
    ],
  },
}
