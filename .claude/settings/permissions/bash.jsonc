{
  // Bash command permissions - allowed and denied shell operations
  // This should only ever be running in a devcontainer, so pretty lenient permissions are allowed
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      // AI interactions and tooling
      "Bash(bd *)",
      // Cloud Infrastructure
      "Bash(aws sts get*)",
      // Code Quality & Formatting
      "Bash(pre-commit run *)",
      "Bash(prek run *)",
      // Core Shell Commands
      "Bash(COMMAND *)", // used in slash commands
      "Bash(kill *)",
      "Bash(ps *)",
      "Bash(pwd *)",
      "Bash(time *)",
      "Bash(timeout *)",
      "Bash(which *)",
      "Bash(xargs *)",
      // Custom Scripts
      "Bash(~/.agents/helpers/*)",
      "Bash(~/.claude/helpers/*)",
      "Bash(~/.claude/hooks/*)",
      "Bash(~/.agents/skills/*)",
      "Bash(~/.claude/skills/*)",
      "Bash(.claude/skills/**/*)",
      // File System
      "Bash(bat *)",
      "Bash(cd /workspaces/*)",
      "Bash(chmod *)",
      "Bash(cp *)",
      "Bash(eza *)",
      "Bash(fd *)",
      "Bash(find *)",
      "Bash(fzf *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(stat *)",
      "Bash(tar *)",
      "Bash(touch *)",
      "Bash(tree *)",
      // Git & Version Control - anything not explicitly denied
      "Bash(git *)",
      // Github
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run download *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh repo view *)", // AGENTS.md has Claude check repo visibility with it before posting
      // Misc
      "Bash(amp *)",
      "Bash(atuin *)",
      "Bash(bc *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(lsof *)",
      "Bash(task *)", // Task runner invocation is freely allowed.  Write access to the taskfiles themselves is protected by Ask.
      "Bash(test *)",
      "Bash(xxd)", // this invocation can be used to read, but not to write (so no " *" after it)
      "Bash(zk *)",
      // Node.js
      "Bash(pnpm list *)",
      "Bash(pnpm test*)",
      "Bash(pnpm view *)",
      // Python
      "Bash(uv run pytest *)",
      // Text Processing
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(echo *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(printf *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      // Search
      "Bash(rg *)"
      // Research
    ],
    "ask": [
      // let's hold off before we let it use the github CLI in any free running allow mode...I don't want it somehow approving PRs with the user's credentials
      "Bash(gh repo fork *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)",
      "Bash(aws *)", // let's hold off before we let it use AWS CLI in any free running allow mode. We need to be very sure we don't have any access to staging or production credentials in our dev environment (...which we shouldn't...but we need to double check that or consider any other safeguards first)
      // start to give a little more free rein for non-permanent PR activity
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)"
    ],
    "deny": [
      // Exceptions to generally allowed AI tooling
      "Bash(bd init*)", // we need to control the init process, don't let AI do that in the background
      // Github
      // Claude should not ever interfere with the PR process, that is how we gate AI's work
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review *)",
      "Bash(gh pr update-branch *)",
      // Raw API access and the token itself would let Claude get around every gh rule in this file. Scripts that need the API (like the address-pr-comments skill) are reviewed and run gh api themselves.
      "Bash(gh api *)",
      "Bash(gh auth token*)",
      "Bash(gh auth status *-t*)", // -t / --show-token prints the token
      // Creating or changing repositories should be a deliberate human step, so run these yourself with `!`
      "Bash(gh repo archive *)",
      "Bash(gh repo autolink create *)",
      "Bash(gh repo autolink new *)",
      "Bash(gh repo autolink delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo new *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo sync *)",
      "Bash(gh repo unarchive *)",
      // Task must run the repo's own taskfiles, which are the reviewed ones. These flags are the only ways to point it elsewhere (there is no environment variable equivalent -- https://github.com/go-task/task/issues/1721 was closed as a duplicate with nothing implemented), and `/tmp` is writable without a prompt, so without these denials `Bash(task *)` would be an allow-anything entry.
      "Bash(task -t *)",
      "Bash(task --taskfile *)",
      "Bash(task --taskfile=*)",
      "Bash(task --entrypoint *)",
      "Bash(task --entrypoint=*)",
      "Bash(task -d *)",
      "Bash(task --dir *)",
      "Bash(task --dir=*)",
      "Bash(task -g *)",
      "Bash(task --global *)",
      // Same reasoning for the hook runners: they must run the repo's own reviewed .pre-commit-config.yaml, and these flags are how to point them at another config or another repo
      "Bash(pre-commit run -c *)",
      "Bash(pre-commit run --config *)",
      "Bash(pre-commit run --config=*)",
      "Bash(prek run -c *)",
      "Bash(prek run --config *)",
      "Bash(prek run --config=*)",
      "Bash(prek run -C *)",
      "Bash(prek run --cd *)",
      "Bash(prek run --cd=*)",

      // Destructive File Operations
      "Bash(chmod -R *)",
      "Bash(chown -R *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      // Dangerous Disk Operations
      "Bash(> /dev/sda*)",
      "Bash(> /etc/*)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      // Process Management
      "Bash(kill -9 *)",
      "Bash(killall *)",
      // Git & Version Control
      "Bash(git push -f *)",
      "Bash(git push --force*)",
      "Bash(git push --tags*)",
      // Node.js
      "Bash(npm publish *)",
      // System Administration
      "Bash(doas *)",
      "Bash(passwd *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(systemctl *)",
      "Bash(userdel *)",
      "Bash(usermod *)",
      // System Control
      "Bash(reboot *)",
      "Bash(shutdown *)"
    ]
  }
}
