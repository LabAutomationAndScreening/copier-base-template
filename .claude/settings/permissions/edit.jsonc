{
  // Edit permissions for specific files
  // This should only ever be running in a devcontainer, so pretty lenient permissions are allowed
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Edit(/tmp/**/*)", "Edit(/workspaces/**/tmp/**)", "Edit(tmp/**)"],
    // Agents are allowed to run any task, but this provides some basic protection against editing a task to do something nefarious that's normally forbidden.
    "ask": ["Edit(Taskfile.yaml)", "Edit(.config/taskfiles/**)"],
  },
}
